# ============================================================
# AI-Security-Guardian Compose prod-drill environment
# ------------------------------------------------------------
# Purpose:
# - Local production-style Docker Compose startup/config tests.
# - Use this only with docker-compose.yml + docker-compose.prod-drill.yml.
# - App/database/Redis service connections use Compose service names.
# - No customer domain, customer IP, customer database, customer Redis, or
#   customer data is referenced here.
# ============================================================

PROD_DRILL_COMPOSE_PROJECT_NAME=ai-security-guardian

# ===== Required secrets =====
SECRET_KEY=25df4c76a5a6fc16e26264f12ae343e1c23bd092746834af1083ab1c503c3763

# ===== Administrator authentication =====
ADMIN_USERNAME=admin
ADMIN_ROLE=admin
ADMIN_PASSWORD_HASH=pbkdf2:sha256:600000$0bgkTrvALPvg46rs$6728e97158d2518303c85977efefef529c756f3cd0137d97c31f21bd0d62785f
ADMIN_PASSWORD=

# ===== Compose prod-drill database =====
DATABASE_URL=postgresql+psycopg2://guardian_local:guardian-local-postgres-pass-2026@postgres:5432/guardian_local_prodtest
PROD_DRILL_DATABASE_URL=postgresql+psycopg2://guardian_local:guardian-local-postgres-pass-2026@postgres:5432/guardian_local_prodtest
PROD_DRILL_POSTGRES_DB=guardian_local_prodtest
PROD_DRILL_POSTGRES_USER=guardian_local
PROD_DRILL_POSTGRES_PASSWORD=guardian-local-postgres-pass-2026
AUTO_CREATE_DB_TABLES=false
DB_CONNECT_TIMEOUT_SEC=3

# ===== Compose prod-drill Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=guardian-local-redis-pass-2026
PROD_DRILL_REDIS_HOST=redis
PROD_DRILL_REDIS_PORT=6379
PROD_DRILL_REDIS_DB=0
PROD_DRILL_REDIS_PASSWORD=guardian-local-redis-pass-2026
REDIS_CONNECT_TIMEOUT_SEC=0.5
REDIS_SOCKET_TIMEOUT_SEC=2.0
HEALTHCHECK_DEPENDENCY_TIMEOUT_SEC=0.5

# ===== Threat intelligence API keys =====
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# ===== LLM API =====
DEEPSEEK_API_BASE=
DEEPSEEK_API_KEY=

# ===== Alert notification =====
ALERT_EMAIL=
ALERT_WEBHOOK=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_FROM=
ALERT_SMTP_USE_TLS=true
ALERT_NOTIFY_MAX_RETRIES=3
ALERT_ENTERPRISE_CHANNEL_ENABLED=false

# ===== Response loop =====
RESPONSE_FIREWALL_BACKEND=iptables
RESPONSE_HOST_ISOLATION=none
RESPONSE_BUSINESS_IP_WHITELIST=
RESPONSE_PRIVATE_IP_WHITELIST=
RESPONSE_ALLOW_PRIVATE_BAN=false
REAL_ENFORCEMENT_APPROVAL_REQUIRED=false
REAL_ENFORCEMENT_AUDIT_VERIFIED=false
REAL_ENFORCEMENT_ROLLBACK_READY=false
REAL_ENFORCEMENT_UNBLOCK_READY=false
REAL_ENFORCEMENT_REVIEW_REQUIRED=false

# ===== Security and web configuration =====
FLASK_ENV=production
AUDIT_ENV=production
AUDIT_LOG_DIR=
LOG_LEVEL=INFO
API_RATE_LIMIT=100 per minute
ALLOWED_ORIGINS=https://guardian.localtest
JWT_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=86400
LOG_INTEGRITY_ENABLED=true
RUNTIME_GUARDS_ENABLED=true
REQUIRE_REDIS_AVAILABLE=true
REQUIRE_MODELS_READY=true

# ===== Main entrypoint =====
DRY_RUN=true
ENABLE_PACKET_CAPTURE=false
ENABLE_WEB_LOG=false
PACKET_INTERFACE=
WEB_LOG_PATH=/var/log/nginx/access.log
MAX_PACKETS_PER_TICK=50
LOOP_INTERVAL_SEC=1.0

# ===== Model artifacts =====
MODEL_DIR=models/saved
MODEL_DELIVERY_MODE=artifact
MODEL_ARTIFACT_URI=file:///opt/guardian/model-artifacts/current

# ===== Flask integration =====
ENABLE_FLASK=false

# ===== Build acceleration =====
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
APT_MIRROR=
