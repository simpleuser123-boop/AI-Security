{
  "schema_name": "ioc_match_v1",
  "schema_version": "1",
  "description": "威胁情报命中上下文（IP / 域名 / 哈希 / CVE 等）。",
  "required_fields": {
    "ioc_type": {"type": "string", "policy": "forbid_silent_fill"},
    "ioc_value": {"type": "string", "policy": "forbid_silent_fill"},
    "observed_at": {"type": "string", "policy": "forbid_silent_fill"}
  },
  "optional_fields": {
    "source_feed": {"type": "string", "policy": "optional"},
    "confidence": {"type": "number", "policy": "optional"},
    "related_ip": {"type": "string", "policy": "optional"},
    "cve_id": {"type": "string", "policy": "optional"},
    "ttl_sec": {"type": "number", "policy": "optional"}
  }
}
