# Host non-degraded test environment.
# Use this only from the host OS. PostgreSQL and Redis are reached through
# 127.0.0.1 published ports from docker-compose.local-deps.yml.

FLASK_ENV=testing
DATABASE_URL=postgresql+psycopg2://guardian:guardian-local-postgres-pass@127.0.0.1:55432/guardian_local_test

LOCAL_POSTGRES_PORT=55432
LOCAL_POSTGRES_DB=guardian_local_test
LOCAL_POSTGRES_USER=guardian
LOCAL_POSTGRES_PASSWORD=guardian-local-postgres-pass

LOCAL_REDIS_PORT=56379
REDIS_HOST=127.0.0.1
REDIS_PORT=56379
REDIS_DB=0
REDIS_PASSWORD=guardian-local-redis-pass
GUARDIAN_REDIS_DISABLE_CONNECT=false
REQUIRE_REDIS_AVAILABLE=true
REQUIRE_MODELS_READY=true
RUNTIME_GUARDS_ENABLED=true
MODEL_DIR=models/saved
