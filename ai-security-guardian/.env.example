# ============================================================
# AI-Security-Guardian 环境变量模板（Phase 8）
# ------------------------------------------------------------
# 1) 复制为 .env 后再修改: cp .env.example .env
# 2) 任何真正的密钥 / 密码 / API Key 只写入 .env，永远不要提交到版本控制
# 3) 部分字段生产环境为必填，本文件以注释说明
# ============================================================

# ===== 必须配置 =====
# 使用 python -c "import secrets; print(secrets.token_hex(32))" 生成（至少 32 字符）
# 生产环境：禁止使用本文件中的示例值、dev-only 默认串；缺失或弱密钥将导致启动失败
SECRET_KEY=REPLACE_ME_WITH_64_HEX_CHARS

# ===== 管理员认证 =====
ADMIN_USERNAME=admin
# 基础 RBAC 角色：viewer 仅读，analyst 可处置告警，admin 可改配置/规则/IOC/封禁并查询审计。
ADMIN_ROLE=admin
# 【生产必填】Werkzeug 安全哈希。通过下列命令生成：
#   python scripts/generate_admin_password_hash.py
# 然后把命令输出的整行粘贴到此处（形如 pbkdf2:sha256:600000$SALT$HASH）
ADMIN_PASSWORD_HASH=
# 【仅开发/测试】若未配置 ADMIN_PASSWORD_HASH，将回退到明文 ADMIN_PASSWORD；
# FLASK_ENV=production 时仅接受 ADMIN_PASSWORD_HASH，明文路径不可用。
ADMIN_PASSWORD=changeme

# ===== 数据库 =====
# 开发默认：SQLite（建议先用它一键启动）
DATABASE_URL=sqlite:///data/security.db
# 生产必须使用 PostgreSQL（请改为真实地址）：
# DATABASE_URL=postgresql+psycopg2://guardian:REPLACE_WITH_STRONG_PASSWORD@postgres.example.com:5432/guardian_prod
# 生产默认不在应用启动时自动建表；首次建表请在发布/维护窗口显式执行 `python -m web.init_db`
# AUTO_CREATE_DB_TABLES 仅保留为开发/应急开关，不作为正式生产发布方案。
AUTO_CREATE_DB_TABLES=false

# ===== Redis =====
# 在 docker-compose 内 REDIS_HOST 会被自动设置为 "redis"；
# 本地开发默认连接 localhost:6379。
# 【生产必填】REDIS_PASSWORD 非空；compose 中有密码时 Redis 启用 requirepass
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Redis 客户端快速失败，避免健康检查或接口探测在错误密码/网络异常时长时间阻塞
REDIS_CONNECT_TIMEOUT_SEC=0.5
REDIS_SOCKET_TIMEOUT_SEC=2.0

# ===== 威胁情报 API Key（可选）=====
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# ===== LLM API（可选：DeepSeek/OpenAI-compatible）=====
# 示例:
# DEEPSEEK_API_BASE=https://api.deepseek.com
# DEEPSEEK_API_KEY=sk-...
DEEPSEEK_API_BASE=
DEEPSEEK_API_KEY=

# ===== 告警通知（可选）=====
ALERT_EMAIL=
ALERT_WEBHOOK=
# SMTP（与 ALERT_EMAIL 收件人配合；需同时配置 ALERT_SMTP_HOST / FROM）
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_FROM=
ALERT_SMTP_USE_TLS=true
ALERT_NOTIFY_MAX_RETRIES=3
# 企业微信/钉钉等占位通道（true 时仅打日志，不外呼）
ALERT_ENTERPRISE_CHANNEL_ENABLED=false

# ===== 响应闭环 R4（可选）=====
# 防火墙后端：iptables | windows_placeholder | cloud_sg_placeholder
RESPONSE_FIREWALL_BACKEND=iptables
# 主机隔离：none | logging（未配置 none 时 critical 降级为人工待办）
RESPONSE_HOST_ISOLATION=none
# 生产真实封禁禁止的地址：逗号分隔 IPv4；命中则拒绝封禁（含私网段默认拒绝，见代码）
RESPONSE_BUSINESS_IP_WHITELIST=
RESPONSE_PRIVATE_IP_WHITELIST=
# 仅实验环境：允许对 RFC1918/CGNAT 地址下发真实 iptables（默认 false）
RESPONSE_ALLOW_PRIVATE_BAN=false

# ===== 安全 & Web 配置 =====
FLASK_ENV=development
AUDIT_ENV=dev
# 默认按 logs/test|dev|staging|production 隔离；如需显式覆盖再设置 AUDIT_LOG_DIR
AUDIT_LOG_DIR=
LOG_LEVEL=INFO
API_RATE_LIMIT=100 per minute
# 逗号分隔；生产禁止 *；须为真实浏览器 Origin（含协议与主机）
ALLOWED_ORIGINS=http://localhost:5000
JWT_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=86400
LOG_INTEGRITY_ENABLED=true
# 生产落地保护（建议 production=true）：
# true 时 Redis 不可用将直接启动失败（不允许自动降级 memory）
REQUIRE_REDIS_AVAILABLE=false
# true 时关键模型文件缺失将直接启动失败
REQUIRE_MODELS_READY=false

# ===== Phase 8：主入口（main.py）专用 =====
# 响应演练模式：true 时防火墙动作只打印日志，不实际执行 iptables
# 生产环境明确设置为 false 之前，请确认已有回滚/解封流程
DRY_RUN=true

# 是否启用抓包入口（需要 CAP_NET_RAW 或 sudo；Docker 默认关闭）
ENABLE_PACKET_CAPTURE=false

# 是否启用 Web 日志采集入口
ENABLE_WEB_LOG=false

# 抓包网卡名；留空由 Scapy 自动选择默认网卡
PACKET_INTERFACE=

# Web 访问日志路径（主入口会增量读取）
WEB_LOG_PATH=/var/log/nginx/access.log

# 主循环每 tick 最多处理的数据包数（限流降频）
MAX_PACKETS_PER_TICK=50
LOOP_INTERVAL_SEC=1.0

# 模型目录（只读挂载到容器）
MODEL_DIR=models/saved
# 模型交付策略：
# - repository: 模型文件随仓库/工作区交付
# - artifact: 模型文件通过制品库或共享盘单独下发
MODEL_DELIVERY_MODE=artifact
# 当 MODEL_DELIVERY_MODE=artifact 时，记录模型获取地址或制品说明
MODEL_ARTIFACT_URI=

# 主入口是否接入 Phase 7 Flask 工厂广播告警到前端（仅在完整链路场景使用）
ENABLE_FLASK=false

# ===== Phase 8：docker 构建加速（仅国内网络需要）=====
# PIP 镜像：空则使用官方源 pypi.org
# 例: https://pypi.tuna.tsinghua.edu.cn/simple
PIP_INDEX_URL=
# apt 镜像：空则使用官方 deb.debian.org
# 例: mirrors.tuna.tsinghua.edu.cn
APT_MIRROR=

# ===== Phase 8：完整检测链路（guardian profile）专用 =====
# 只有执行 `docker compose --profile full-chain up` 时才会读取以下变量
# guardian 容器以 host 网络运行，访问 Redis 的主机地址需要写宿主机 IP / 127.0.0.1
REDIS_HOST_FOR_GUARDIAN=127.0.0.1
